datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  passwordHash            String
  avatar                  String?
  emailVerified           DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  sessions                Session[]
  workspaceMembers        WorkspaceMember[]
  documentsAuthored       Document[]
  comments                Comment[]
  resolvedComments        Comment[]                @relation("ResolvedComments")
  documentVersions        DocumentVersion[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  userAgent    String?
  ipAddress    String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  email     String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  email     String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model RateLimitRecord {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime

  @@index([key])
  @@index([expiresAt])
  @@map("rate_limit_records")
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  slug      String            @unique
  icon      String            @default("🚀")
  plan      String            @default("Free")
  ownerId   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  members   WorkspaceMember[]
  documents Document[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("editor") // "owner" | "admin" | "editor" | "commenter" | "viewer"
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Document {
  id          String    @id @default(uuid())
  title       String    @default("Untitled Document")
  icon        String    @default("📄")
  content     String    @default("<p></p>")
  excerpt     String?
  yjsState    Bytes?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isStarred   Boolean   @default(false)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?
  tags        String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    Comment[]
  versions    DocumentVersion[]

  @@index([workspaceId])
  @@index([authorId])
  @@map("documents")
}

model DocumentVersion {
  id              String    @id @default(uuid())
  documentId      String
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber   Int
  title           String?
  contentSnapshot String    @default("<p></p>")
  yjsSnapshot     Bytes?
  changeSummary   String?
  addedCount      Int       @default(0)
  removedCount    Int       @default(0)
  authorId        String?
  author          User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([createdAt])
  @@map("document_versions")
}

model Comment {
  id             String    @id @default(uuid())
  documentId     String
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId       String
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[] @relation("CommentReplies")
  text           String
  quote          String?
  anchorPosition String?
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation("ResolvedComments", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt @default(now())

  @@index([documentId])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}
