# ==========================================
# CollabSpace Environment Configuration Example
# ==========================================

# PostgreSQL Database Connection
# Default matches docker-compose.yml configuration
DATABASE_URL="postgresql://collabspace:collabspace_local_dev@127.0.0.1:5432/collabspace?schema=public"

# Redis Connection (Rate limiting & Real-time caching)
REDIS_URL="redis://127.0.0.1:6379"

# Session & Security Secret (Generate a strong 32+ character random string)
SESSION_SECRET="replace-with-a-secure-random-32-char-secret"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Real-Time WebSocket Collaboration Service
COLLAB_PORT="1234"
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"

# Production Email Provider (SMTP / Resend / SendGrid)
# When omitted, verification links and reset tokens will be safely logged to the server console.
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASSWORD="your-smtp-password"
# EMAIL_FROM="CollabSpace <noreply@collabspace.dev>"
