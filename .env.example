# ==============================================================================
# CollabSpace Environment Configuration Template
# ==============================================================================
# This template documents environment variables for local development,
# Render deployment, and Vercel hybrid deployment.
#
# IMPORTANT:
# - Never commit actual passwords, private tokens, or secrets to Git.
# - On cloud platforms (Vercel, Render, Railway), configure these in the dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT CONFIGURATION (Default .env)
# ------------------------------------------------------------------------------

# PostgreSQL Database Connection (matches docker-compose.yml)
DATABASE_URL="postgresql://collabspace:collabspace_local_dev@127.0.0.1:5432/collabspace?schema=public"

# Optional direct database connection (used for migrations if different from DATABASE_URL)
# DIRECT_URL="postgresql://collabspace:collabspace_local_dev@127.0.0.1:5432/collabspace?schema=public"

# Redis Connection (Pub/Sub & Caching)
REDIS_URL="redis://127.0.0.1:6379"

# Base Application URL (Local Next.js dev server)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Real-Time WebSocket Collaboration Service (Local)
COLLAB_PORT="1234"
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"

# Secret key for signing short-lived (60s) HMAC-SHA256 WebSocket authentication tickets.
# In production, must be a high-entropy 256-bit random string (generate with: openssl rand -hex 32).
# Must match identically across both the Next.js API server (issuer) and the Collab WebSocket server (verifier).
COLLAB_WS_TOKEN_SECRET="replace-with-a-secure-random-256-bit-secret"

# Allowed Origins for WebSocket server (comma-separated list).
# Note: Bare multi-tenant wildcards (*.vercel.app, *.onrender.com) are strictly prohibited for security.
# Project-scoped patterns (collabspace-*.vercel.app) and exact domains are supported.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional Email Provider (SMTP) - omitted falls back to console logging
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASSWORD="your-smtp-password"
# EMAIL_FROM="CollabSpace <noreply@collabspace.dev>"

# ------------------------------------------------------------------------------
# 2. RENDER PRODUCTION DEPLOYMENT MATRIX
# ------------------------------------------------------------------------------
# The production architecture uses two Render Web Services:
# - Service A: collabspace-web    (Next.js App & REST APIs)
# - Service B: collabspace-collab  (WebSocket Yjs Collaboration Server)
#
# [Service A: collabspace-web]
# - NODE_ENV="production"                     (Runtime)
# - DATABASE_URL="<render-internal-pg-url>"   (Build & Runtime, append ?sslmode=require)
# - REDIS_URL="<render-internal-redis-url>"   (Runtime, uses rediss:// protocol)
# - NEXT_PUBLIC_APP_URL="https://<web-service>.onrender.com"        (BUILD TIME: inlined into bundle)
# - NEXT_PUBLIC_COLLAB_WS_URL="wss://<collab-service>.onrender.com" (BUILD TIME: inlined into bundle)
# - COLLAB_WS_TOKEN_SECRET="<generate-with-openssl-rand-hex-32>"    (Runtime: issues 60s tickets)
# - NODE_OPTIONS="--max-old-space-size=384"   (Runtime: guards against 512MB RAM OOM)
#
# [Service B: collabspace-collab]
# - NODE_ENV="production"                     (Runtime: enables strict origin checking)
# - PORT=10000                                (Runtime: auto-injected by Render)
# - DATABASE_URL="<render-internal-pg-url>"   (Runtime: persistence flushes via Prisma)
# - REDIS_URL="<render-internal-redis-url>"   (Runtime: Pub/Sub multi-instance sync)
# - COLLAB_WS_TOKEN_SECRET="<same-secret-as-service-a>"             (Runtime: verifies 60s tickets)
# - NEXT_PUBLIC_APP_URL="https://<web-service>.onrender.com"        (Runtime: origin validation)
# - ALLOWED_ORIGINS="https://<web-service>.onrender.com"            (Runtime: origin allowlist)
# - NODE_OPTIONS="--max-old-space-size=384"   (Runtime: guards against 512MB RAM OOM)

# ------------------------------------------------------------------------------
# 3. VERCEL + HYBRID PRODUCTION DEPLOYMENT MATRIX
# ------------------------------------------------------------------------------
# Hybrid production architecture:
# - Web Application & REST APIs: Deployed on Vercel Serverless
# - Collaboration Service: Deployed on dedicated WebSocket host (Render / Railway / Fly.io / VPS)
# - Database: Neon Serverless PostgreSQL (with connection pooling)
# - Pub/Sub & Cache: Upstash Redis (with rediss:// TLS protocol)
#
# [Vercel Project Environment Variables - collabspace-web]
# - NODE_ENV="production"
# - DATABASE_URL="postgresql://user:pass@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require" (Neon Pooled URL)
# - DIRECT_URL="postgresql://user:pass@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"         (Neon Direct URL for migrations)
# - REDIS_URL="rediss://default:token@region.upstash.io:6379"                                       (Upstash TLS URL for comment notifications)
# - COLLAB_WS_TOKEN_SECRET="<generate-with-openssl-rand-hex-32>"                                   (Runtime: issues 60s tickets)
# - NEXT_PUBLIC_APP_URL="https://collabspace.vercel.app"                                            (Production app URL - inlined at build)
# - NEXT_PUBLIC_COLLAB_WS_URL="wss://collabspace-ws.onrender.com"                                  (WebSocket host URL - inlined at build)
#
# [Dedicated WebSocket Host - collabspace-collab on Render / Railway / Fly.io]
# - NODE_ENV="production"
# - PORT="10000"                                                                                    (Auto-injected or specified port)
# - DATABASE_URL="postgresql://user:pass@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require" (Neon Pooled URL for persistence)
# - REDIS_URL="rediss://default:token@region.upstash.io:6379"                                       (Upstash TLS URL for cross-instance Pub/Sub)
# - COLLAB_WS_TOKEN_SECRET="<same-secret-as-vercel-web>"                                           (Runtime: verifies 60s tickets)
# - NEXT_PUBLIC_APP_URL="https://collabspace.vercel.app"
# - ALLOWED_ORIGINS="https://collabspace.vercel.app,collabspace-*.vercel.app"                       (Project-scoped preview matching; bare *.vercel.app is blocked)
# ==============================================================================
